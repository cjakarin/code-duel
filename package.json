{
  "name": "code-duel",
  "version": "2.3.2",
  "description": "Code Duel v2 — ระบบประลองการเขียนโปรแกรมเชิงแข่งขันแบบเรียลไทม์ รันโค้ดในคอนเทนเนอร์ Docker",
  "license": "MIT",
  "main": "server.js",
  "scripts": {
    "preinstall": "node check.js --warn",
    "start": "node server.js",
    "check": "node check.js",
    "build-runner": "docker build --pull -t code-duel-runner:2 -f docker/runner.Dockerfile docker",
    "security": "node check.js --security && npm audit --omit=dev"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "express": "4.22.3",
    "katex": "0.19.0",
    "marked": "12.0.2",
    "monaco-editor": "0.45.0",
    "socket.io": "4.8.4"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "overrides": {
    "engine.io": "6.6.11",
    "encodeurl": "2.0.2",
    "object-inspect": "1.13.4"
  }
}
