{
  "name": "code-duel",
  "version": "2.3.0",
  "description": "Code Duel v2 — ระบบประลองการเขียนโปรแกรมเชิงแข่งขันแบบเรียลไทม์ รันโค้ดในคอนเทนเนอร์ Docker",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build-runner": "docker build -t code-duel-runner:2 -f docker/runner.Dockerfile docker",
    "check": "node -e \"require('./sandbox')({executor:'docker',dockerCmd:'docker',image:'code-duel-runner:2'}).check().then(r=>{console.log(r.ok?'✔ '+r.message:'✖ '+r.message);process.exit(r.ok?0:1)})\""
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "express": "^4.19.2",
    "katex": "0.19.0",
    "marked": "12.0.2",
    "monaco-editor": "0.45.0",
    "socket.io": "^4.7.5"
  },
  "engines": {
    "node": ">=22"
  }
}